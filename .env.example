# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Cloud SQL for PostgreSQL (automatically injected at runtime)
SQL_HOST="127.0.0.1"
SQL_DB_NAME="postgres"
SQL_USER="app_user"
SQL_PASSWORD="app_password"
SQL_ADMIN_USER="admin_user"
SQL_ADMIN_PASSWORD="admin_password"

# Commercial Market Data Provider (Optional: 'auto' | 'polygon' | 'finnhub' | 'yahoo')
# Configure in Secrets to switch from preview feed to licensed commercial quotes/history
MARKET_DATA_PROVIDER="auto"
POLYGON_API_KEY="MY_POLYGON_API_KEY"
FINNHUB_API_KEY="MY_FINNHUB_API_KEY"

# Stripe Subscriptions & Webhook Verification (Server-Side Only)
STRIPE_SECRET_KEY="MY_STRIPE_SECRET_KEY"
STRIPE_WEBHOOK_SECRET="MY_STRIPE_WEBHOOK_SECRET"
STRIPE_PRICE_PRO="MY_STRIPE_PRICE_PRO"
STRIPE_PRICE_ADVISOR="MY_STRIPE_PRICE_ADVISOR"
# Optional: Stripe one-time coupon ($11 off once on $12/mo Pro) for $1 first-month intro offer
STRIPE_PRO_INTRO_COUPON="MY_STRIPE_PRO_INTRO_COUPON"

# Optional comma-separated owner/admin emails granted full Advisor tier access
ADMIN_EMAILS="owner@example.com"


